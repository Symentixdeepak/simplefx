{
  "manifest_version": 3,
  "name": "SimpleFX Cross-Hedge Sync",
  "version": "1.0.0",
  "description": "Automated Cross-Liquidation to Take-Profit synchronization for SimpleFX WebTrader",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://app.simplefx.com/*",
    "https://*.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.simplefx.com/*",
        "http://localhost:3000/mock.html*",
        "http://127.0.0.1:3000/mock.html*",
        "https://*.onrender.com/mock.html*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
